# Copy to .env.local and fill in for local development (Phase 2).
# VITE_* values are bundled into the public browser build: only the
# Supabase project URL and the PUBLISHABLE key belong here.
# Never put the Supabase secret / service-role key in any VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
