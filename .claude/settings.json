{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.*.local)",
      "Edit(./.env.development)",
      "Edit(./.env.production)",
      "Read(./supabase/.env*)",
      "Edit(./supabase/.env*)",
      "Bash(npx supabase link:*)",
      "Bash(npx supabase db push:*)",
      "Bash(supabase link:*)",
      "Bash(supabase db push:*)"
    ]
  }
}
